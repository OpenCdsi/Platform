<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:OpenCdsi.VaxEngine.Mobile.ViewModels"
             x:Class="OpenCdsi.VaxEngine.Mobile.Views.AddDosePage"
             x:DataType="vm:AddDoseViewModel"
             Title="Add immunization"
             BackgroundColor="{StaticResource SurfacePage}">

    <VerticalStackLayout Padding="16" Spacing="4">

        <Label Text="Vaccine" FontSize="12" TextColor="{StaticResource TextSecondary}" />
        <SearchBar Text="{Binding SearchText}" Placeholder="Search by name or CVX code" Margin="0,0,0,4" />

        <CollectionView ItemsSource="{Binding SearchResults}"
                         SelectionMode="Single"
                         SelectedItem="{Binding SelectedOption}"
                         ItemTemplate="{StaticResource CvxOptionItemTemplate}"
                         HeightRequest="180"
                         Margin="0,0,0,16" />

        <Label Text="Date Administered" FontSize="12" TextColor="{StaticResource TextSecondary}" />
        <DatePicker Date="{Binding DateAdministered}" MaximumDate="{x:Static sys:DateTime.Today}"
                    Margin="0,0,0,20" />

        <Button Text="Save dose"
                Command="{Binding SaveCommand}"
                BackgroundColor="{StaticResource BrandPrimary}"
                TextColor="White" />

    </VerticalStackLayout>

</ContentPage>
