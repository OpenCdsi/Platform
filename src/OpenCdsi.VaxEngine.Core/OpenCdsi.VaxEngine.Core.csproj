<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenCdsi.VaxEngine.Core</RootNamespace>
    <LangVersion>12</LangVersion>

    <!-- Required for Mobile to build for Android/Windows since Core became a ProjectReference
         (was a NuGet package): confirmed by a real CI failure (NETSDK1047, "doesn't have a
         target for 'net10.0/android-arm64'") that declaring RuntimeIdentifiers on Mobile.csproj
         ALONE is not enough - Core's own project.assets.json still lacked the RID-qualified
         section even though Core built successfully (plain net10.0) in the same run. NuGet's
         RID-aware restore graph does not auto-generate a compatible entry for a referenced
         project that declares no RuntimeIdentifiers of its own (an earlier, wrong assumption
         behind the Mobile-only fix) - each project in the graph needs matching RIDs declared
         directly for its own assets.json to gain that RID-qualified section at all. Core has no
         native/platform-specific code, so this doesn't change its actual compiled output for any
         consumer (Api/Functions/Demo/external NuGet) - it only adds RID-qualified restore-graph
         entries alongside the existing plain net10.0 one. -->
    <RuntimeIdentifiers>android-arm64;android-x64;win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Follows directly from RuntimeIdentifiers above - confirmed missing by a real local
         repro (`dotnet build ... -f net10.0-android`, which reproduced the CI failure exactly
         and iterates in seconds instead of a CI round-trip): the build log shows THREE separate
         builds of Core - plain net10.0 (succeeds), then net10.0/android-arm64 and
         net10.0/android-x64 (each fails: MSB3030, "Could not copy ... because it was not
         found"). Core is a plain library with no AppendRuntimeIdentifierToOutputPath of its own,
         so even when MSBuild invokes it specifically "for android-arm64," its actual compiled
         output still lands in the same unqualified obj/Release/net10.0/ folder as always - but
         the RID-qualified build pass that invoked it expects to find (and copy) the result from
         obj/Release/net10.0/android-arm64/, which Core never populates. Conditioned on
         RuntimeIdentifier being set so it's a no-op for every non-RID consumer
         (Api/Functions/Demo/external NuGet, and Core's own plain net10.0 build for Mobile) -
         $(RuntimeIdentifier) is empty there, so appending nothing leaves the output path
         unchanged. -->
    <AppendRuntimeIdentifierToOutputPath Condition="'$(RuntimeIdentifier)' != ''">true</AppendRuntimeIdentifierToOutputPath>

    <!-- AppendRuntimeIdentifierToOutputPath above only affects OutputPath (bin) - confirmed by a
         real local repro with `-v:d` verbose logging (much faster to iterate than a CI
         round-trip): the log shows bin/Release/net10.0/android-arm64/... being correctly
         referenced (an expected-not-yet-exists deps.json check), while the actual MSB3030
         failure is obj/Release/net10.0/android-arm64/OpenCdsi.VaxEngine.Core.dll "not found" -
         the OBJ (intermediate) path was NOT similarly RID-qualified, so CoreCompile wrote its
         output to the plain obj/Release/net10.0/ folder while the later copy step looked for it
         at the RID-qualified one. A known SDK gap: AppendRuntimeIdentifierToOutputPath doesn't
         also cover IntermediateOutputPath, so it needs its own explicit override here, appended
         onto whatever IntermediateOutputPath already resolved to (respecting the SDK's own
         default Configuration+TargetFramework nesting) rather than reconstructed from scratch. -->
    <IntermediateOutputPath Condition="'$(RuntimeIdentifier)' != ''">$(IntermediateOutputPath)$(RuntimeIdentifier)\</IntermediateOutputPath>
  </PropertyGroup>

  <!--
    NuGet packaging metadata. Version is auto-derived from git tags by MinVer (see the
    PackageReference below) rather than hand-maintained - MinVerTagPrefix="engine-v" means it
    only ever looks at this repo's engine-v* tags (this is a monorepo; mobile-v* tags are
    correctly ignored). On the exact tagged commit this resolves to a clean X.Y.Z; on any commit
    past the last tag it computes a height-based prerelease (e.g. 2.0.1-alpha.0.4), so local/dev
    builds still get a sane, unique version with nothing to remember to bump by hand.

    License is MPL-2.0, confirmed directly against the real LICENSE file at the repo root and
    every source file's own header (both agree) - not assumed from the header comment alone.

    Deliberately doesn't set GeneratePackageOnBuild - `dotnet pack` on demand is the more common,
    less surprising default; regular `dotnet build` runs shouldn't also produce a .nupkg.

    RepositoryUrl/PackageProjectUrl are left out rather than guessed at - add these once the repo
    has a real, public URL to point to.
  -->
  <PropertyGroup>
    <PackageId>OpenCdsi.VaxEngine.Core</PackageId>
    <MinVerTagPrefix>engine-v</MinVerTagPrefix>
    <Authors>Dennis Dunn</Authors>
    <Description>A .NET implementation of the CDC's CDSi (Clinical Decision Support for Immunization) Logic Specification v4.6. Given a patient's vaccination history, determines their immunization forecast - which doses are valid, due, past due, or complete - against the CDC's own reference data. Reference data (antigen schedules, series definitions) is supplied externally at runtime rather than bundled into the package, so a new CDC schedule drop doesn't require a new package release.</Description>
    <PackageTags>CDSi;immunization;vaccine;vaccination;forecasting;CDC;healthcare;clinical-decision-support</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Dennis Dunn</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 ("missing XML comment for publicly visible type or member") and CS1573
         ("parameter has no matching param tag, but other parameters do") are both suppressed
         deliberately: this project's own doc-comment convention documents WHY a class or method
         works the way it does (the design reasoning) and calls out specific parameters only when
         they genuinely need explanation - not a summary or a <param> tag on every single public
         member/parameter for its own sake. Confirmed against the real pattern before suppressing,
         not assumed: e.g. EvaluateSeriesHistory.Execute has <param> tags for the three parameters
         that need explaining (antigenAdministeredRecords, priorEvaluatedDosesFromOtherAntigens,
         assessmentDate) and none for the four self-explanatory ones (patient, series,
         conflictsByImpactedCvx, resolveCompletedSeries) - exactly the selective style these two
         warnings would otherwise force out of, replacing it with boilerplate tags with no real
         content just to silence the compiler, not genuinely better documentation. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only (PrivateAssets=All) - computes Version/PackageVersion/AssemblyVersion
         etc. from git tags/history, doesn't ship as a runtime dependency of the package itself.
         Needs full git history to see tags (fetch-depth: 0 in CI - already set in
         publish-nuget.yml for its own separate "is this tag reachable from main" check, so no
         extra CI change needed here) and needs an actual .git directory - the plain source
         archive this migration handed off as a .tar.gz does include .git, so this works
         out of the box once restored. -->
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
