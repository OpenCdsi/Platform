<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenCdsi.Mobile.ViewModels"
             xmlns:models="clr-namespace:OpenCdsi.Mobile.Models"
             xmlns:conv="clr-namespace:OpenCdsi.Mobile.Converters"
             x:Class="OpenCdsi.Mobile.Views.QuickForecastResultPage"
             x:DataType="vm:QuickForecastResultViewModel"
             Title="Forecast result"
             BackgroundColor="{StaticResource SurfacePage}">

    <ContentPage.Resources>
        <conv:ForecastStatusToColorConverter x:Key="StatusToColor" />
        <conv:ForecastStatusToLabelConverter x:Key="StatusToLabel" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="16,12" Spacing="2"
                              BackgroundColor="{StaticResource BrandPrimary}">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Forecast result" FontSize="16" TextColor="White" />
                <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0" Padding="6,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Label Text="Not saved" FontSize="10" TextColor="White" />
                </Border>
            </Grid>
            <Label FontSize="12" TextColor="White" Opacity="0.85">
                <Label.Text>
                    <MultiBinding StringFormat="Born {0:dd MMM yyyy} — {1}">
                        <Binding Path="DateOfBirth" />
                        <Binding Path="Gender" />
                    </MultiBinding>
                </Label.Text>
            </Label>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ForecastEntry">
                    <VerticalStackLayout Padding="16,12" Spacing="6"
                                         BackgroundColor="{StaticResource SurfaceCard}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding AntigenName}"
                                   FontSize="15" TextColor="{StaticResource TextPrimary}" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusToColor}}"
                                    StrokeThickness="0" Padding="8,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                                       FontSize="12" TextColor="White" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding ReasonText}" FontSize="13"
                               TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Save as patient"
                Command="{Binding SaveAsPatientCommand}"
                BackgroundColor="{StaticResource BrandPrimary}"
                TextColor="White"
                Margin="16" />

    </Grid>

</ContentPage>
