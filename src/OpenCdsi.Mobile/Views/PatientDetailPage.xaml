<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenCdsi.Mobile.ViewModels"
             xmlns:models="clr-namespace:OpenCdsi.Mobile.Models"
             xmlns:conv="clr-namespace:OpenCdsi.Mobile.Converters"
             x:Class="OpenCdsi.Mobile.Views.PatientDetailPage"
             x:DataType="vm:PatientDetailViewModel"
             Title="{Binding Patient.FullName}"
             BackgroundColor="{StaticResource SurfacePage}">

    <ContentPage.Resources>
        <conv:CvxCodeToDisplayNameConverter x:Key="CvxToDisplayName" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditPatientCommand}" />
        <ToolbarItem Text="Delete" Command="{Binding DeletePatientCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{Binding Patient.DateOfBirth, StringFormat='Born {0:dd MMM yyyy}'}"
                   FontSize="12" TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding Patient.Gender}"
                   FontSize="12" TextColor="{StaticResource TextSecondary}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,4">
                <Label Grid.Column="0" Text="Immunization history"
                       FontSize="13" TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+"
                        Command="{Binding AddDoseCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource BrandPrimary}"
                        FontSize="18" Padding="8,0" />
            </Grid>

            <CollectionView ItemsSource="{Binding Patient.ImmunizationEvents}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ImmunizationEvent">
                        <Grid Padding="12,10" ColumnDefinitions="*,Auto,Auto"
                              BackgroundColor="{StaticResource SurfaceCard}">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding CvxCode, Converter={StaticResource CvxToDisplayName}}"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding DateAdministered, StringFormat='{0:dd MMM yyyy}'}"
                                       FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding CvxCode, StringFormat='CVX {0}'}"
                                   FontSize="11" FontFamily="Courier" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Start" Margin="0,0,10,0" />
                            <Label Grid.Column="2" Text="&#10005;" FontSize="14" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" Padding="10,0,0,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.VoidDoseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="View forecast"
                    Command="{Binding ViewForecastCommand}"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    TextColor="White"
                    Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
