<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenCdsi.Mobile.ViewModels"
             xmlns:models="clr-namespace:OpenCdsi.Mobile.Models"
             x:Class="OpenCdsi.Mobile.Views.ReferenceLibraryPage"
             x:DataType="vm:ReferenceLibraryViewModel"
             Title="Vaccine reference"
             BackgroundColor="{StaticResource SurfacePage}">

    <Grid RowDefinitions="Auto,*">

        <SearchBar Grid.Row="0"
                   Placeholder="Search antigens"
                   Text="{Binding SearchText}"
                   Margin="12,8"
                   BackgroundColor="{StaticResource SurfaceCard}" />

        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Chapters}"
                         SelectionMode="Single"
                         SelectionChangedCommand="{Binding OpenChapterCommand}"
                         SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AntigenChapterListItem">
                    <Grid Padding="16,12"
                          ColumnDefinitions="*,Auto"
                          BackgroundColor="{StaticResource SurfaceCard}">
                        <Label Grid.Column="0" Text="{Binding DiseaseName}"
                               FontSize="15" TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Column="1" Text="&#8250;" FontSize="16" TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
