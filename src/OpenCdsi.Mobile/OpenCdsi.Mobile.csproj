<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android and Windows for now; add net10.0-ios/net10.0-maccatalyst back here if/when needed.
		     The Windows TFM is conditioned on IsOSPlatform('windows') - its tooling (WinUI/Windows App
		     SDK) isn't available when restoring/building on the Linux CI runner or in this sandbox, so
		     an unconditioned entry would break `dotnet restore` there even though the Android job only
		     ever builds `-f net10.0-android` explicitly. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Required since Core became a ProjectReference (was a NuGet package): an Android build
		     needs per-ABI native output even for plain `dotnet build`, not just `publish`, so it
		     looks up RID-qualified targets like "net10.0/android-arm64" in every referenced
		     project's own restored assets - Core included. A compiled NuGet package never needed
		     its own RID-qualified restore entry, but a live ProjectReference does. Without this,
		     `dotnet restore` (no -r flag anywhere in the Android CI job) never knows a RID is
		     coming, builds a RID-agnostic graph, and the later `-f net10.0-android` build (run
		     with restore skipped) discovers the gap too late - confirmed by a real CI failure: NETSDK1047,
		     "doesn't have a target for 'net10.0/android-arm64'"/'net10.0/android-x64'. Declaring
		     these here makes THIS project's restore RID-aware, which is enough - Core doesn't need
		     its own RuntimeIdentifiers, since it has no native code, NuGet's restore graph
		     generates a matching RID-qualified entry for a plain referenced library automatically
		     once the outer (this) project's RIDs are known. Scoped to net10.0-android only - the
		     Windows TFM already gets its RIDs from an explicit -r flag per-build in CI instead. -->
		<RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-android'">android-arm64;android-x64</RuntimeIdentifiers>

		<OutputType>Exe</OutputType>
		<RootNamespace>OpenCdsi.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>OpenCdsi Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.opencdsi.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Unpackaged win-x64 exe (self-contained publish), not an MSIX - no Microsoft Store, no
		     code-signing certificate, no Developer Mode toggle needed to run it. See
		     https://aka.ms/MauiTemplateUnpackaged if packaged/Store distribution is ever wanted instead. -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="220,178" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- Was a NuGet PackageReference to OpenCdsi.VaxEngine.Core (pulled from GitHub Packages,
		     which required a cross-repo PAT to restore). Now that this project lives in the same
		     repo as Core, a plain ProjectReference always builds against current Engine source -
		     no version bump/publish/PAT dance needed for day-to-day work.

		     GlobalPropertiesToRemove="TargetFramework" is required, not cosmetic - history below,
		     since this went through two wrong attempts before landing here:

		     1. The Windows CI job restores this project with a raw `-p:TargetFramework=
		        net10.0-windows10.0.19041.0` MSBuild property (not `-f` - combining `-f` with `-r`
		        on `dotnet restore` hits a separate, already-worked-around CLI bug there). A `-p:`
		        property is global - it propagates to every project reachable via ProjectReference,
		        so Core.csproj's own single, non-conditioned TargetFramework (net10.0) was getting
		        silently overridden too, and Core's restore never produced a net10.0 entry at all -
		        NETSDK1005, "doesn't have a target for 'net10.0'". Never came up while Core was a
		        compiled NuGet package - only once it became a live ProjectReference.

		     2. First fix attempt: SetTargetFramework="TargetFramework=net10.0" on this reference,
		        pinning it to plain net10.0 regardless of any ambient override. Fixed Windows, but
		        broke Android once Core also gained RuntimeIdentifiers (needed separately - Android
		        needs per-ABI native output even for `dotnet build`, and a referenced project needs
		        its own matching RuntimeIdentifiers declared for NuGet's RID-aware restore graph to
		        produce a RID-qualified section for it at all). The pin unconditionally forced this
		        reference to build RID-LESS regardless of platform, so Android's build - now
		        correctly expecting Core's RID-qualified output (obj/.../android-arm64/...) - found
		        only the plain, unqualified build and failed: MSB3030, "Could not copy ... because
		        it was not found."

		     3. GlobalPropertiesToRemove strips the incoming global TargetFramework property for
		        THIS reference specifically, rather than overriding it with a fixed replacement -
		        it fixes the original Windows leak (Core's own declared TargetFramework governs its
		        evaluation again, unaffected by the CLI's global property) without pinning away
		        RID context, so the SDK's normal per-reference TFM/RID negotiation - which now
		        correctly produces RID-qualified output for Android/Windows since Core declares
		        matching RuntimeIdentifiers - isn't overridden into a fixed, RID-less shape. -->
		<ProjectReference Include="..\OpenCdsi.VaxEngine.Core\OpenCdsi.VaxEngine.Core.csproj" GlobalPropertiesToRemove="TargetFramework" />
	</ItemGroup>

</Project>
