<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android and Windows for now; add net10.0-ios/net10.0-maccatalyst back here if/when needed.
		     The Windows TFM is conditioned on IsOSPlatform('windows') - its tooling (WinUI/Windows App
		     SDK) isn't available when restoring/building on the Linux CI runner or in this sandbox, so
		     an unconditioned entry would break `dotnet restore` there even though the Android job only
		     ever builds `-f net10.0-android` explicitly. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Required since Core became a ProjectReference (was a NuGet package): an Android build
		     needs per-ABI native output even for plain `dotnet build`, not just `publish`, so it
		     looks up RID-qualified targets like "net10.0/android-arm64" in every referenced
		     project's own restored assets - Core included. A compiled NuGet package never needed
		     its own RID-qualified restore entry, but a live ProjectReference does. Without this,
		     `dotnet restore` (no -r flag anywhere in the Android CI job) never knows a RID is
		     coming, builds a RID-agnostic graph, and the later `-f net10.0-android` build (run
		     with restore skipped) discovers the gap too late - confirmed by a real CI failure: NETSDK1047,
		     "doesn't have a target for 'net10.0/android-arm64'"/'net10.0/android-x64'.

		     Two corrections to the reasoning this originally shipped with, both learned the hard
		     way via later CI failures - noted here since a future reader (human or Claude) working
		     from just this comment would otherwise repeat the same wrong turns:
		     - "Core doesn't need its own RuntimeIdentifiers" was wrong. It does (see
		       OpenCdsi.VaxEngine.Core.csproj) - restore's RID-aware graph does not auto-generate a
		       compatible entry for a referenced project that declares no RuntimeIdentifiers of its
		       own; each project in the graph needs matching RIDs declared directly.
		     - "the Windows TFM gets its RIDs from an explicit -r flag in CI instead" was also
		       wrong, or at least fragile - that pattern (raw -p:TargetFramework= combined with a
		       raw -r flag, both CLI-level overrides) hit NETSDK1005 (TargetFramework leaking into
		       Core's restore) even after ProjectReference-level fixes that correctly solved the
		       same leak for Android. Windows now uses the identical -f-plus-declared-property
		       pattern below, for the same reason. -->
		<RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-android'">android-arm64;android-x64</RuntimeIdentifiers>
		<!-- Same reasoning as the Android RuntimeIdentifiers above, and required for the same
		     reason Windows CI now restores with plain `-f net10.0-windows10.0.19041.0` (see
		     build-mobile.yml's build-windows job) rather than a raw -p:TargetFramework=/-r
		     combination - this is what supplies RID awareness now that the CLI no longer does. -->
		<RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">win-x64;win-arm64</RuntimeIdentifiers>

		<OutputType>Exe</OutputType>
		<RootNamespace>OpenCdsi.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>OpenCdsi Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.opencdsi.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- An installable, self-signed MSIX rather than an unpackaged exe/zip - gives testers a real
		     installer (Start Menu entry, clean uninstall) instead of "unzip and run". Not Store-signed,
		     so it needs a certificate; the release workflow signs with the self-signed one in
		     scripts/generate-signing-cert.sh (its public half lives at
		     src/OpenCdsi.Mobile/assets/opencdsi-mobile-signing-cert.cer, for testers to trust once -
		     see this project's own README). -->
		<WindowsPackageType>MSIX</WindowsPackageType>
		<AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
		<AppxBundle>Never</AppxBundle>
		<UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
		<GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="220,178" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- Was a NuGet PackageReference to OpenCdsi.VaxEngine.Core (pulled from GitHub Packages,
		     which required a cross-repo PAT to restore). Now that this project lives in the same
		     repo as Core, a plain ProjectReference always builds against current Engine source -
		     no version bump/publish/PAT dance needed for day-to-day work.

		     GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier" is required, not cosmetic
		     - history below, since this went through several wrong attempts before landing here:

		     1. The Windows CI job restores this project with a raw `-p:TargetFramework=
		        net10.0-windows10.0.19041.0` MSBuild property (not `-f` - combining `-f` with `-r`
		        on `dotnet restore` hits a separate, already-worked-around CLI bug there). A `-p:`
		        property is global - it propagates to every project reachable via ProjectReference,
		        so Core.csproj's own single, non-conditioned TargetFramework (net10.0) was getting
		        silently overridden too, and Core's restore never produced a net10.0 entry at all -
		        NETSDK1005, "doesn't have a target for 'net10.0'". Never came up while Core was a
		        compiled NuGet package - only once it became a live ProjectReference.

		     2. Fix attempt: SetTargetFramework="TargetFramework=net10.0" on this reference,
		        pinning it to plain net10.0 regardless of any ambient override. Fixed Windows, but
		        broke Android once Core also gained RuntimeIdentifiers (added to fix a SEPARATE
		        NETSDK1047 - a referenced project needs its own matching RuntimeIdentifiers
		        declared for NuGet's RID-aware restore graph to produce a RID-qualified section for
		        it at all). The pin unconditionally forced this reference to build RID-LESS
		        regardless of platform, so Android's build - now correctly expecting Core's
		        RID-qualified output - found only the plain, unqualified build: MSB3030,
		        "Could not copy ... because it was not found."

		     3. Fix attempt: GlobalPropertiesToRemove="TargetFramework" alone (strip the leak
		        rather than pin an override). Fixed Windows without re-breaking Android's TFM
		        selection, but the SAME MSB3030 persisted - a local repro (much faster than CI:
		        `dotnet build src/OpenCdsi.Mobile/OpenCdsi.Mobile.csproj -c Release -f
		        net10.0-android`) plus `-v:d` verbose logging showed Core's RID-specific build pass
		        DOES run, but writes its output to the plain obj/bin path while the SDK's own copy
		        step looks for it at a RID-qualified one - Core has no AppendRuntimeIdentifierToOutputPath
		        of its own. Adding that (and a matching IntermediateOutputPath override) only made
		        it worse - a malformed, doubled path (android-arm64/net10.0/android-arm64/...) -
		        revealing a wrong assumption about what IntermediateOutputPath already resolved to.

		     4. What actually explains all of this: a real, open, currently-unresolved Microsoft SDK
		        issue (search "the RuntimeIdentifier should not be used when determining the
		        outputs of referenced class libraries") describes this exact scenario as a BUG -
		        RuntimeIdentifier propagating into a referenced class library's output-path
		        determination is not supposed to happen at all, and a related dotnet/sdk issue
		        tracking the same propagation problem has been open since 2020. Fighting the SDK
		        to make Core cooperate with RID-specific building (attempts 2-3) was the wrong
		        direction - the documented workaround is to stop RuntimeIdentifier from reaching
		        this reference in the first place, same as TargetFramework already was. Core keeps
		        its own RuntimeIdentifiers declaration (still needed for restore's RID-qualified
		        graph generation), but this reference no longer asks it to actually BUILD per-RID. -->
		<ProjectReference Include="..\OpenCdsi.VaxEngine.Core\OpenCdsi.VaxEngine.Core.csproj" GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier" />

		<!-- Same GlobalPropertiesToRemove requirement and reasoning as the Core reference above -
		     OpenCdsi.ClinicalReference.csproj carries the matching RuntimeIdentifiers declaration. -->
		<ProjectReference Include="..\OpenCdsi.ClinicalReference\OpenCdsi.ClinicalReference.csproj" GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier" />
	</ItemGroup>

</Project>
